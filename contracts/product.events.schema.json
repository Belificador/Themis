{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themis.local/contracts/product.events.schema.json",
  "title": "ProductEvent",
  "description": "Eventos product.created / product.updated / product.deleted emitidos por catalog-service. Version 2: precios duales EUR/USD.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "product_id",
    "sku",
    "product_name",
    "brand",
    "model",
    "ram_gb",
    "storage_gb",
    "color",
    "category",
    "cost_price_eur",
    "price_eur",
    "cost_price_usd",
    "price_usd",
    "threshold",
    "timestamp"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "product.created",
        "product.updated",
        "product.deleted"
      ]
    },
    "product_id": {
      "type": "string",
      "format": "uuid"
    },
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "ram_gb": {
      "type": "integer",
      "minimum": 0
    },
    "storage_gb": {
      "type": "integer",
      "minimum": 0
    },
    "color": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "phone",
        "tablet",
        "accessory"
      ]
    },
    "threshold": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cost_price_eur": {
      "type": "string",
      "description": "Coste EUR serializado como string para preservar precision."
    },
    "price_eur": {
      "type": "string",
      "description": "Precio EUR serializado como string para preservar precision."
    },
    "cost_price_usd": {
      "type": "string",
      "description": "Coste USD serializado como string para preservar precision."
    },
    "price_usd": {
      "type": "string",
      "description": "Precio USD serializado como string para preservar precision."
    }
  }
}
