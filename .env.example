# ---- Global ----
# Copy this file to `.env` and adjust values. Never commit real secrets.
LOG_LEVEL=INFO

# ---- Supabase Storage (imágenes de producto y facturas) ----
# Obtén Project URL, anon public y service_role secret en Settings → API de Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PRODUCT_IMAGES=product-images
SUPABASE_BUCKET_INVOICES=sales-invoices

# ---- Supabase PostgreSQL (esquema único themis) ----
# Ref del proyecto: yeaylufnjeyiutyxqict (host: db.yeaylufnjeyiutyxqict.supabase.co)
SUPABASE_DB_PASSWORD=
DB_SCHEMA=themis

# ---- media ----
IMAGE_MAX_BYTES=5242880
INVOICE_MAX_BYTES=10485760

# ---- CORS (si el frontend se despliega aparte, p. ej. Vercel) ----
# Orígenes separados por coma, p. ej. https://tu-app.vercel.app
CORS_ORIGINS=
# Regex opcional para previews de Vercel: https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# ---- puerto (host) ----
PORT=8000
