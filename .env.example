# ---- Global ----
# Copy this file to `.env` and adjust values. Never commit real secrets.
LOG_LEVEL=INFO

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
PRODUCTS_EXCHANGE=products
STOCK_EXCHANGE=stock

# ---- catalog-service ----
CATALOG_DATABASE_URL=postgresql+asyncpg://catalog:catalog@postgres-catalog:5432/catalog

# ---- inventory-service ----
INVENTORY_DATABASE_URL=postgresql+asyncpg://inventory:inventory@postgres-inventory:5432/inventory
INVENTORY_QUEUE=inventory.product_events
OUTBOX_INTERVAL_SECONDS=1

# ---- notification-service ----
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://notification:notification@postgres-notification:5432/notification
NOTIFICATION_QUEUE=notification.stock_events
DEDUPE_WINDOW_SECONDS=300
MAX_ATTEMPTS=3

# Telegram: create a bot with @BotFather and obtain your chat id.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (Meta). Leave empty to run in dry-run mode.
WHATSAPP_ENABLED=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
WHATSAPP_API_VERSION=v20.0

# ---- sales-service ----
SALES_DATABASE_URL=postgresql+asyncpg://sales:sales@postgres-sales:5432/sales

# ---- Supabase Storage (imágenes de producto y facturas) ----
# Obtén Project URL, anon public y service_role secret en Settings → API de Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PRODUCT_IMAGES=product-images
SUPABASE_BUCKET_INVOICES=sales-invoices

# ---- Supabase PostgreSQL (una base, un esquema por servicio) ----
# Ref del proyecto: yeaylufnjeyiutyxqict (host: db.yeaylufnjeyiutyxqict.supabase.co)
SUPABASE_DB_PASSWORD=
DB_SCHEMA_CATALOG=catalog
DB_SCHEMA_INVENTORY=inventory
DB_SCHEMA_NOTIFICATION=notification
DB_SCHEMA_SALES=sales

# ---- media (facturas e imágenes de producto) ----
CATALOG_MEDIA_DIR=/data/media
SALES_MEDIA_DIR=/data/media
IMAGE_MAX_BYTES=5242880
INVOICE_MAX_BYTES=10485760

# ---- api-gateway ----
CATALOG_URL=http://catalog-service:8000
INVENTORY_URL=http://inventory-service:8000
NOTIFICATION_URL=http://notification-service:8000
SALES_URL=http://sales-service:8000
STATIC_DIR=/app/static

# ---- modo local sin Docker (opcional) ----
# scripts/run_local.sh exporta estas variables directamente.
# EVENT_BUS=http
# EVENT_RELAY_URL=http://localhost:8090
# RELAY_DB=.local/data/relay.db

# ---- ports (host) ----
GATEWAY_PORT=8080
RABBITMQ_MANAGEMENT_PORT=15672
